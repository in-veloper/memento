<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    위젯 리시버는 앱 자체 매니페스트가 아니라 여기(라이브러리 모듈)에 둔다.
    앱 매니페스트는 prebuild 가 app.json 으로 다시 만들기 때문에, 직접 넣으면
    다음 prebuild 때 사라진다. 라이브러리 매니페스트는 빌드할 때 병합된다.

    android:exported="true" 는 필수다 — 런처/잠금화면이 다른 프로세스에서
    APPWIDGET_UPDATE 브로드캐스트를 보내야 해서, 위젯 리시버는 항상 노출돼
    있어야 한다(안 그러면 시스템이 위젯을 아예 붙이지 못한다).
  -->
  <application>
    <receiver
      android:name="expo.modules.todaywidget.TodayWidgetProvider"
      android:exported="true"
      android:label="@string/today_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/today_widget_info" />
    </receiver>

    <!-- 카드 본문(ListView) 을 채워 주는 서비스. 위젯 호스트(런처/잠금화면)만
         붙을 수 있어야 하므로 BIND_REMOTEVIEWS 권한을 요구한다 — 표준 관례. -->
    <service
      android:name="expo.modules.todaywidget.TodayFrontRemoteViewsService"
      android:exported="true"
      android:permission="android.permission.BIND_REMOTEVIEWS" />
  </application>
</manifest>
